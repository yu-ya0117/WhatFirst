<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div style="color: red">
      <h2>入力内容にエラーがあります</h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label "タスク名", style: "display: block" %>
    <%= form.text_field :title, class: "text-field"%>
  </div>

  <div class="form-group">
    <%= form.label "優先度", style: "display: block" %>

    <label>
      <%= form.radio_button :priority, "high" %> 高
    </label>

    <label>
      <%= form.radio_button :priority, "medium" %> 中
    </label>

    <label>
      <%= form.radio_button :priority, "low" %> 低
    </label>
  </div>

  <!--
   <div>
     <%= form.label :completed, style: "display: block" %>
     <%= form.checkbox :completed %>
   </div>
  -->

  <div>
    <%= form.submit task.persisted? ? "更新" : "作成", class: "btn" %>
  </div>
<% end %>
