<div class="task-list">
  <% flash.each do |type, msg| %>
    <div class="flash flash-<%= type %>">
      <%= msg %>
    </div>
  <% end %>
  <% content_for :title, "Tasks" %>

  <h1>WhatFirst</h1>

  <%= button_to "タスク追加", new_task_path, class: "btn", method: :get %>

  <hr>
  <% previous_priority = nil %>
  <div id="tasks">
    <% @tasks.each do |task| %>
      <% if previous_priority && previous_priority != task.priority %>
        <hr>
      <% end %>

      <%= render task %>
      <p>
        <%= link_to "タスクの詳細", task %>
      </p>
      <% previous_priority = task.priority %>
    <% end %>
  </div>
</div>
