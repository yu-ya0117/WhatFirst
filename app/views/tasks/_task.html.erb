<div id="<%= dom_id task %>" class="<%= 'task-completed' if task.completed? %>">
  <div style="display: flex; justify-content: space-between; gap: 10px; align-items: center;">
    <div>
      <p>
        <span class="priority-tag priority-<%= task.priority %>">
          【<%= task.priority_label %>】
        </span> 
        <%= task.title %>
      </p>
    </div>
    <div>
      <%= form_with model: task,
                    url: complete_task_path(task),
                    method: :patch,
                    local: true do |f|%>
        <%= f.check_box :completed %>
        <%= f.submit "完了", class: "btn" %>
      <% end %>
    </div>
  </div>
</div>
